# Northline backend environment — copy to backend/.env and fill in.
# No spaces around "=".

# --- Required ---
GROQ_API_KEY=
TAVILY_API_KEY=
AVIATIONSTACK_API_KEY=
OPENWEATHER_API_KEY=
# Neon pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Long-term memory (Mem0) ---
MEM0_API_KEY=
MEM0_ENABLED=true
MEMORY_TOP_K=8

# --- Admin console (must match VITE_ADMIN_API_KEY in frontend/.env) ---
ADMIN_API_KEY=dev-admin-key

# --- Optional: LangSmith tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=northline-travel

# --- Inngest (background eval jobs) ---
# Local dev: INNGEST_DEV=1 (no keys needed; app crashes on startup without this or real keys).
# Production: remove INNGEST_DEV and set INNGEST_EVENT_KEY + INNGEST_SIGNING_KEY.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Optional: guardrails / server ---
GUARDRAILS_ENABLED=true
GUARDRAIL_MODEL=llama-3.1-8b-instant
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NORTHLINE_PORT=8000
